package main

import (
	"net/http"

	"$ProjectName$/controllers"

	"github.com/gin-gonic/gin"
	"github.com/goyourt/yogourt/routing"
)

type NewPassword struct {
	Password    string `json:"password"`
	NewPassword string `json:"new_password"`
}

func POST(c *gin.Context) {
	var req NewPassword
	if !routing.HandleRequest(c, &req) {
		return
	}

	err := controllers.UpdatePassword(c, req.Password, req.NewPassword)
	if err != nil {
		routing.RespondAndAbort(c, http.StatusUnauthorized, err.Error())
		return
	}

	routing.RespondNoContent(c)
}

func main() {}
