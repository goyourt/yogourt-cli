
app_name: "$ProjectName$"
version: "1.0.0"
mode: "development"

# env_files: ".env" # string or list of .env files loaded before the config is expanded

server:
  port: 8080
  host: "localhost"
  cors: true
  # base_path: "/api"
  # base_url: "http://localhost:8080"
  # read_header_timeout: "10s"
  # read_timeout: "30s"
  # write_timeout: "30s"
  # idle_timeout: "60s"
  # max_body_bytes: 33554432 # 32 MiB

database:
  type: "postgres"
  user: "admin"
  password: "password"
  host: "localhost"
  port: 5432
  db: "mydb"
  # Local Postgres without TLS: loopback hosts require this flag,
  # otherwise ssl_mode must be verify-full.
  allow_insecure_loopback: true
  ssl_mode: "disable"
  # search_path: "public"
  # pool:
  #   max_open_conns: 25
  #   max_idle_conns: 5
  #   conn_max_lifetime: "30m"

cache:
  host: "localhost"
  port: "6379"
  password: "cache-key"
  db: 0
  # tls:
  #   enabled: false

paths:
  route_folder: "./api/"
  model_folder: "./models/"

security:
  secret_key: "supersecret"
  token_expires: 1440 # one day, in minutes
  # token_issuer: "$ProjectName$"
  # token_audience: "$ProjectName$-web"
  # hash_cost: 10
  # password_minimum_length: 8
  # password_special_char_required: false
  # password_number_required: false
  # password_upper_case_required: false
  # password_lower_case_required: false

cors:
  allow_all_origins: true
  # allowed_origins: ["http://localhost:3000"]
  # allowed_methods: ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
  # allowed_headers: ["Content-Type", "Authorization"]
  # allow_credentials: false
  # max_age: 3600
