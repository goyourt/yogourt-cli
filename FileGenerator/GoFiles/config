
app_name: "$ProjectName$"
version: "1.0.0"
mode: "development"

server:
  port: 8080
  host: "localhost"
  cors: true

database:
  type: "postgres"
  user: "admin"
  password: "password"
  host: "localhost"
  port: 5432
  db: "mydb"
  allow_insecure_loopback: true
  ssl_mode: "disable"

cache:
  host: "localhost"
  port: "6379"
  password: "cache-key"
  db: 0

paths:
  route_folder: "./api/"
  model_folder: "./models/"
  project_name: "$ProjectName$"
  main_file: "./main.go"
  route_folder: "api"

security:
  secret_key: "supersecret"
  token_expires: 1440 # one day, in minutes

cors:
  allow_all_origins: true
