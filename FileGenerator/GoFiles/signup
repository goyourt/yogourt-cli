package main

import (
	"net/http"

	"$ProjectName$/controllers"

	"github.com/gin-gonic/gin"
	"github.com/goyourt/yogourt/routing"
)

type SignupRequest struct {
	Username string `json:"username"`
	Password string `json:"password"`
}

func POST(c *gin.Context) {
	var req SignupRequest
	if !routing.HandleRequest(c, &req) {
		return
	}

	if controllers.IsExistingUsername(req.Username) {
		routing.RespondAndAbort(c, http.StatusConflict, "Username already exists")
		return
	}

	user, err := controllers.CreateUser(c, req.Username, req.Password)
	if err != nil {
		routing.RespondAndAbort(c, http.StatusInternalServerError, "Could not create user")
		return
	}

	routing.RespondSuccess(c, http.StatusCreated, &user)
}

func main() {}
