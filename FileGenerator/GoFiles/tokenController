package controllers

import (
	"$ProjectName$/models"

	"github.com/gin-gonic/gin"
	"github.com/goyourt/yogourt/services"
	"github.com/goyourt/yogourt/services/database"
)

func CreateToken(c *gin.Context, user models.User) (models.Token, error) {
	tokenString, err := services.CreateToken(user.GetUuid())
	if err != nil {
		return models.Token{}, err
	}

	token := models.Token{
		Security: user.GetSecurity(),
		Token:    tokenString,
	}
	err = database.CreateDataWriter(c).Create(&token)

	return token, err
}
