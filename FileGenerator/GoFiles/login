package main

import (
    "fmt"
	"net/http"

	"github.com/gin-gonic/gin"
	"github.com/goyourt/yogourt/routing"

	"$ProjectName$/controllers"
)

type LoginRequest struct {
	Username string `json:"username"`
	Password string `json:"password"`
}

func POST(c *gin.Context) {
	var req LoginRequest
	if !routing.HandleRequest(c, &req) {
		return
	}

	user, err := controllers.VerifyCredentials(req.Username, req.Password)
	if err != nil {
        routing.RespondAndAbort(c, http.StatusUnauthorized, fmt.Errorf("invalid credentials").Error())
		return
	}

	token, err := controllers.CreateToken(c, user)
	if err != nil {
		routing.RespondAndAbort(c, http.StatusInternalServerError, "Could not create token")
		return
	}

	routing.RespondWithContent(c, http.StatusOK, "token", token.GetToken())
}

func main() {}
