package models

import (
	"fmt"

	"github.com/goyourt/yogourt/interfaces"
	"github.com/goyourt/yogourt/services/database"
)

type Token struct {
	interfaces.Base
	SecurityId *int      `gorm:"not null" json:"-"`
	Security   *Security `gorm:"foreignKey:SecurityId; references:ID;constraint:OnUpdate:CASCADE,OnDelete:CASCADE;" json:"-"`
	Token      *string   `gorm:"not null" json:"token"`
}

func (u *Token) GetSecurity() *Security {
	if nil == u.SecurityId {
		u.SecurityId = new(int)
	}
	database.HydrateRelation(u, "Security", u.Security, *u.SecurityId)
	return u.Security
}

func (u *Token) SetSecurity(Security *Security) error {
	u.Security = Security
	*u.SecurityId = Security.GetID()
	return nil
}

func (u *Token) GetToken() string {
	if nil == u.Token {
		return ""
	}
	return *u.Token
}

func (u *Token) SetToken(Token string) error {
	if len(Token) == 0 {
		return fmt.Errorf("This field cannot be empty")
	}
	if nil == u.Token {
		u.Token = new(string)
	}
	*u.Token = Token
	return nil
}
