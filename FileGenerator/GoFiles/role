package models

import (
	"fmt"

	"github.com/goyourt/yogourt/interfaces"
)

type Role struct {
	interfaces.Base
	Name string `gorm:"not null;unique" json:"name"`
}

// Champ Name
func (u *Role) GetName() string {
	return u.Name
}

func (u *Role) SetName(Name string) error {
	if len(Name) == 0 {
		return fmt.Errorf("Le nom ne peut pas être vide")
	}
	u.Name = Name
	return nil
}
